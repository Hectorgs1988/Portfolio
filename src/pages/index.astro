---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Héctor García | Portfolio"
	description="Portfolio personal de Héctor García: experiencia, proyectos, stack y contacto."
>
	<div class="site-bg">
		<header class="topbar">
			<div class="shell topbar-inner">
				<a href="#inicio" class="brand" aria-label="Ir al inicio">
					&lt;dev /&gt;
				</a>
				<nav aria-label="Principal" class="menu-wrap">
					<ul class="menu">
						<li><a href="#inicio">Inicio</a></li>
						<li><a href="#sobre-mi">Sobre mi</a></li>
						<li><a href="#experiencia">Experiencia</a></li>
						<li><a href="#proyectos">Proyectos</a></li>
						<li><a href="#skills">Skills</a></li>
						<li><a href="#contacto">Contacto</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<section id="inicio" class="section hero">
				<div class="shell hero-shell">
					<p class="section-index">Hola, me llamo</p>
					<h1>Héctor García</h1>
					<p class="lead">
						Software engineer especializado en aplicaciones web modernas, automatización y sistemas de simulación para robótica móvil.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="#proyectos"
							>Ver proyectos</a
						>
						<a class="btn btn-ghost" href="#contacto">Contacto</a>
					</div>
					<a
						class="scroll-hint"
						href="#sobre-mi"
						aria-label="Ir a la seccion sobre mi">↓</a
					>
				</div>
			</section>

			<section id="sobre-mi" class="section shell two-col">
				<div>
					<p class="section-index">01.</p>
					<h2>Sobre mi</h2>
					<p>
						Soy ingeniero informático con experiencia en el desarrollo de herramientas software para 
						automatización, testing y simulación en robótica móvil (AGVs/AMRs).
					</p>
					<p>
						Durante varios años he trabajado en el sector de la robótica industrial participando en la 
						instalación, puesta en marcha y validación de sistemas en clientes internacionales.
					</p>
					<p>
						Actualmente desarrollo aplicaciones web y herramientas de software para automatizar procesos, 
						validar sistemas y crear plataformas técnicas que combinan desarrollo frontend y backend.
					</p>
					<p>
						Me interesa especialmente construir soluciones eficientes y escalables que resuelvan problemas reales, 
						desde plataformas web hasta herramientas de simulación y testing.
					</p>
				</div>
				<div class="photo-wrap" aria-hidden="true">
					<div class="photo-card">tu-foto.jpg</div>
				</div>
			</section>

			<section id="experiencia" class="section shell">
				<p class="section-index">02.</p>
				<h2>Experiencia</h2>
				<div class="experience-list">
					<article class="experience-item">
						<p class="period">2025 - Presente</p>
						<div>
							<h3>Software Tools Developer</h3>
							<p class="company">ABB</p>
							<p>
								Desarrollo de herramientas software internas para automatizar pruebas y simulación 
								de sistemas robóticos móviles (AGVs/AMRs).
							</p>
							<ul class="tags">
								<li>React</li>
								<li>TypeScript</li>
								<li>Testing</li>
								<li>Simulation</li>
							</ul>
						</div>
					</article>

					<article class="experience-item">
						<p class="period">2023 - 2025</p>
						<div>
							<h3>Field QA</h3>
							<p class="company">ABB</p>
							<p>
								Validación de componentes software e integración de sistemas en plataformas robóticas industriales.
							</p>
							<ul class="tags">
								<li>QA</li>
								<li>Integration</li>
								<li>Validation</li>
								<li>Robotics</li>
							</ul>
						</div>
					</article>

					<article class="experience-item">
						<p class="period">2020 - 2023</p>
						<div>
							<h3>R&amp;D - Technology Transfer</h3>
							<p class="company">ASTI Mobile Robotics</p>
							<p>
								Transferencia tecnológica en el área de I+D mediante pruebas, validación y pilotos de nuevos componentes
								y tecnologías para robots móviles industriales (AGVs) antes de su integración en producto.
							</p>
							<ul class="tags">
								<li>AGVs</li>
								<li>Technology transfer</li>
								<li>Component Testing</li>
								<li>System Validation</li>
							</ul>
						</div>
					</article>

					<article class="experience-item">
						<p class="period">2017 - 2020</p>
						<div>
							<h3>Commissioning Engineer</h3>
							<p class="company">ASTI Mobile Robotics</p>
							<p>
								Instalación, programación y puesta en marcha de
								AGVs en clientes internacionales del sector
								industrial.
							</p>
							<ul class="tags">
								<li>PLC</li>
								<li>Automation</li>
								<li>Industrial Systems</li>
								<li>Deployment</li>
							</ul>
						</div>
					</article>

					<article class="experience-item">
						<p class="period">2016 - 2017</p>
						<div>
							<h3>Electromechanical Technician</h3>
							<p class="company">ASTI Mobile Robotics</p>
							<p>
								Montaje, validación y pruebas de sistemas AGV
								antes de su despliegue en cliente.
							</p>
							<ul class="tags">
								<li>Assembly</li>
								<li>Validation</li>
								<li>AGV</li>
								<li>Industrial Robotics</li>
							</ul>
						</div>
					</article>
				</div>
			</section>

			<section id="proyectos" class="section shell">
				<p class="section-index">03.</p>
				<h2>Proyectos</h2>
				<div class="projects-grid">
					<article class="project-card">
						<div class="project-head">
							<h3>Rural Connect</h3>
							<div
								class="project-links"
								aria-label="Enlaces del proyecto"
							>
								<a
									href="https://github.com/Hectorgs1988/ruralConnect-app"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Repositorio de Rural Connect"
								>
